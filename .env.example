# ===========================================================================
# BASE Video Studio — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha os valores reais.
# ===========================================================================

# --- Supabase (Settings → API no painel do Supabase) -----------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                 # anon/public key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                     # ⚠️ SÓ no server — bypassa RLS

# --- fal.ai (https://fal.ai/dashboard/keys) --------------------------------
# OPCIONAL: você pode deixar em branco e configurar a chave DEPOIS, pela aba
# "Configurações" dentro do app (salva criptografada no banco). Se preencher
# aqui, ela vira o padrão. A configuração pela UI tem prioridade.
FAL_KEY=

# --- App -------------------------------------------------------------------
# Em produção, use a URL final da Vercel (https://...vercel.app ou domínio).
# Localmente pode deixar http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PASSWORD=TROQUE-POR-UMA-SENHA-FORTE                              # ⚠️ senha de acesso interno (obrigatório trocar)
CRON_SECRET=troque-por-um-segredo-aleatorio-longo    # protege o endpoint do cron
SESSION_SECRET=troque-por-outro-segredo-aleatorio    # assina o cookie de sessão
